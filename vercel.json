{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/about", "destination": "/html/about.html"},
    {"source": "/services", "destination": "/html/services.html"},
    {"source": "/gallery", "destination": "/html/gallery.html"},
    {"source": "/services/lawn-mowing-edging", "destination": "/html/service-lawn-mowing-edging.html"},
    {"source": "/services/landscaping-mulching", "destination": "/html/service-landscaping-mulching.html"},
    {"source": "/services/trimming-pruning", "destination": "/html/service-trimming-pruning.html"},
    {"source": "/services/yard-leaf-cleanup", "destination": "/html/service-yard-leaf-cleanup.html"},
    {"source": "/services/fertilizing-weed-control", "destination": "/html/service-fertilizing-weed-control.html"},
    {"source": "/services/aeration-overseeding", "destination": "/html/service-aeration-overseeding.html"},
    {"source": "/services/sod-seeding", "destination": "/html/service-sod-seeding.html"},
    {"source": "/services/pressure-washing", "destination": "/html/service-pressure-washing.html"},
    {"source": "/services/debris-hauling", "destination": "/html/service-debris-hauling.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/(.*)\\.(css|js|jpg|jpeg|png|webp|svg)","headers":[
      {"key":"Cache-Control","value":"public, max-age=86400"}]}
  ]
}
